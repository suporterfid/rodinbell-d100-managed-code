<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      net8.0 keeps the Windows transport: FTDI registry plus WMI, which pins a reader to a Windows
      device identity across reconnects. net10.0 is the portable subset - protocol, reader and a
      System.IO.Ports transport - carrying no System.Management and no Windows-only code, so a
      consumer that publishes Native AOT for Linux can reference it without the trim analyzer
      meeting WMI.
    -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>Managed serial protocol client for the Rodinbell D100 UHF RFID reader on Windows.</Description>
    <PackageId>Rodinbell.D100</PackageId>
    <Version>0.1.0</Version>
    <Authors>rodinbell-d100-managed-code contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>RFID;UHF;Rodinbell;D100;serial;EPC</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/suporterfid/rodinbell-d100-managed-code</RepositoryUrl>
    <PackageProjectUrl>https://github.com/suporterfid/rodinbell-d100-managed-code</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Rodinbell.D100.Tests" /></ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
